<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wueasy.waymark</groupId>
    <artifactId>waymark-java-example-spring-boot2</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>waymark-java-example-spring-boot2</name>
    <description>Waymark Java SDK Spring Boot 2 示例（JDK 1.8）：自动配置 + 配置热加载 + 自动注册 + 服务发现</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 与 Spring Boot 2 分支保持一致：JDK 1.8 -->
        <maven.compiler.release>8</maven.compiler.release>
        <waymark.version>0.1.0</waymark.version>
        <spring-boot.version>2.7.12</spring-boot.version>
    </properties>

    <dependencies>
        <!-- 引入 Spring Boot 2 starter 即完成自动装配，无需任何配置类 -->
        <dependency>
            <groupId>com.wueasy.waymark</groupId>
            <artifactId>waymark-spring-boot2-starter</artifactId>
            <version>${waymark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <!-- 用 mvn spring-boot:run 启动示例 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
